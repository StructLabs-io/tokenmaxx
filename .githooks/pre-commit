#!/usr/bin/env bash
# n9c-git-sync v1 — canonical pre-commit auto-sync.
# This file is copied into every repo that uses it, public ones included.
# Keep internal paths, names and incident details out of it.
#
# Pulls the remote default branch before a commit made ON that branch, so
# concurrent agent sessions don't race each other into push rejections.
# Safe by construction:
#   - fires only on the repo's default branch (feature/worktree branches skip)
#   - fail-open on network problems (never blocks a commit because wifi died)
#   - never stashes: fast-forward only, on the tree as it stands (see below)
#   - no GNU `timeout` dependency (absent on stock macOS — the historical
#     hooks silently no-oped because of this); perl alarm wrapper instead
set -uo pipefail

PREFIX="[n9c-sync]"

run_to() { # run_to <seconds> <cmd...> — portable timeout via perl alarm
  perl -e 'my $t = shift @ARGV; alarm $t; exec @ARGV or exit 127' "$@" 2>/dev/null
}

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0
git remote get-url origin >/dev/null 2>&1 || exit 0

BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
DEFAULT_BRANCH="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')"
if [[ -z "$DEFAULT_BRANCH" ]]; then
  for b in main master; do
    if git show-ref --verify --quiet "refs/remotes/origin/$b"; then
      DEFAULT_BRANCH="$b"
      break
    fi
  done
fi
[[ -z "$DEFAULT_BRANCH" || "$BRANCH" != "$DEFAULT_BRANCH" ]] && exit 0

LOCAL_HEAD="$(git rev-parse HEAD 2>/dev/null || echo "")"
REMOTE_HEAD="$(run_to 8 git ls-remote origin "refs/heads/$DEFAULT_BRANCH" | cut -f1)"
[[ -z "$REMOTE_HEAD" || -z "$LOCAL_HEAD" || "$REMOTE_HEAD" == "$LOCAL_HEAD" ]] && exit 0
# Local already contains the remote head (we're ahead) — nothing to sync.
git merge-base --is-ancestor "$REMOTE_HEAD" "$LOCAL_HEAD" 2>/dev/null && exit 0

# No stash, ever (2026-10-10). The stash stack is shared by every worktree and
# session, and a path removed
# from the index but kept on disk (`git rm --cached`) is stashed twice, as
# tracked AND untracked: `stash apply` then restores the whole tree and still
# exits 1 ("already exists, no checkout"), so the hook aborted the commit and
# stranded entries on the shared stack.
# Only a fast-forward is attempted, on the tree as it stands: git refuses it
# whole, touching nothing, when it would overwrite any staged, unstaged or
# untracked change. Diverged or refused: skip, say so in one line, commit.
# After a pull, git always rejects this commit ("cannot lock ref 'HEAD': is at
# X but expected Y": it read HEAD before the hook ran), so stop it ourselves
# with a plain instruction. The staged set is untouched; re-running commits.
SKIPPED="$PREFIX origin/$DEFAULT_BRANCH has new commits; no fast-forward (diverged or local changes in the way) — pre-sync skipped. Before pushing: git pull --no-rebase origin $DEFAULT_BRANCH (never rebase, never stash)."

# Never pull on a temporary index (2026-11-19). A commit that names its paths
# (`--only`, a pathspec, `-a`) runs on one: GIT_INDEX_FILE is then not the real
# `index`. A pull there updates the temporary index, HEAD and the files, and
# leaves the real index at the old HEAD, so every pulled file shows as a staged
# deletion plus an untracked copy, and the next plain commit deletes it from
# the branch.
# So: fetch only (touches no index and no file). If a fast-forward would go
# through, stop the commit and ask for the pull first. If git would refuse it
# anyway (diverged, or an incoming file is changed or untracked here), skip.
if [[ -n "${GIT_INDEX_FILE:-}" && "$(basename "$GIT_INDEX_FILE")" != "index" ]]; then
  if run_to 30 git fetch -q origin "$DEFAULT_BRANCH" \
     && git merge-base --is-ancestor "$LOCAL_HEAD" FETCH_HEAD 2>/dev/null; then
    INCOMING="$(git diff --name-only "$LOCAL_HEAD" FETCH_HEAD 2>/dev/null | sort)"
    LOCAL_DIRT="$( { git diff --name-only HEAD 2>/dev/null; git diff --cached --name-only HEAD 2>/dev/null; git ls-files -o --exclude-standard 2>/dev/null; } | sort -u)"
    OVERLAP="$(comm -12 <(printf '%s\n' "$INCOMING") <(printf '%s\n' "$LOCAL_DIRT") | grep -v '^$' || true)"
    if [[ -z "$OVERLAP" ]]; then
      echo "$PREFIX origin/$DEFAULT_BRANCH has new commits. This commit names its paths, so the hook did not pull (a pull here would leave the index stale). Run: git pull --ff-only origin $DEFAULT_BRANCH   then run the commit again."
      exit 1
    fi
  fi
  echo "$SKIPPED"
  exit 0
fi

if run_to 30 git pull --ff-only -q origin "$DEFAULT_BRANCH"; then
  echo "$PREFIX origin/$DEFAULT_BRANCH had new commits — pulled (fast-forward). Staged changes kept; run the commit again."
  exit 1
else
  echo "$SKIPPED"
fi
exit 0
